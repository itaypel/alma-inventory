# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# סודי! רק בשרת (Vercel). לא לשים בקוד ולא לשתף.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# סיסמה אקראית ארוכה – Vercel שולח אותה כשהוא מפעיל את הדו"ח השבועי
CRON_SECRET=change-me-to-a-long-random-string

# שמות משתמש הופכים לכתובת פנימית (noa.levi@alma.local). אין צורך לשנות.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=alma.local
